# ── flagcast — environment ─────────────────────────────────────────────────
# Copy to .env and adjust. Compose overrides the *_URI/*_URL host parts with
# docker-internal hostnames automatically.

# --- Services ---
PORT=8080
LOG_LEVEL=info

# --- MongoDB ---
MONGO_USER=flagcast
MONGO_PASSWORD=flagcast
MONGO_DB=flagcast
MONGO_URI=mongodb://flagcast:flagcast@localhost:27097/flagcast?authSource=admin

# --- Redis ---
REDIS_URL=redis://localhost:6397/0

# --- NATS ---
NATS_URL=nats://localhost:4297

# --- AI (later phase) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Control-plane security (later phase) ---
GATEWAY_API_KEY=
# Dev only: serve /api with no key. Prod leaves this unset so /api fails closed.
ALLOW_OPEN_API=true
CORS_ORIGINS=
